# The server's settings. Copy this file to .env and fill it in; .env is never
# committed. On a host (Render), set the same names in its environment settings.

# Port to listen on (the frontend expects 3001 when run locally)
PORT=3001

# Supabase: Project Settings > API. The secret (service) key bypasses row-level
# security, so it stays on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Encrypts stored account credentials (refresh tokens, IMAP passwords). 32 random
# bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it later: every connected account would have to be reconnected.
CREDENTIALS_KEY=

# The app's address(es), comma-separated: the only sites allowed to call this
# server. The first is where the browser returns after connecting Gmail.
FRONTEND_URL=http://localhost:5173

# Gmail: an OAuth client (Web application) in Google Cloud Console, with the
# Gmail API enabled. The redirect URI must be listed on the client exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

# AI: Anthropic for the assistant, AI save and Organize; OpenAI for search
# indexing (embeddings) and voice transcription.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: which Claude model to use (default claude-haiku-4-5)
ASSISTANT_MODEL=

# Background sync: a scheduler (e.g. cron-job.org) POSTs /cron/sync with this
# value in an X-Cron-Secret header. Any long random string.
CRON_SECRET=

# Optional, temp addresses: a cPanel mail host on your own domain, and an API
# token from cPanel > Security > Manage API Tokens.
CPANEL_HOST=
CPANEL_USER=
CPANEL_API_TOKEN=
TEMP_MAIL_DOMAIN=
