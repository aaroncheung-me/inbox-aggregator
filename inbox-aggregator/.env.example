# The frontend's settings. Copy this file to .env.local and fill it in;
# .env.local is never committed. On a host (Vercel), set the same names in its
# environment settings. These end up in the browser, so they're public by design.

# Supabase: Project Settings > API. The publishable key is meant for browsers;
# it's used only for sign-in (all data goes through the server).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# The server's address. Leave it out locally: the app then uses port 3001 on
# the same computer, which also works from a phone on the same Wi-Fi.
VITE_API_URL=
